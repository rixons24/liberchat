# Copy to .env and fill in real values before anything but local dev.

DATABASE_URL=postgresql+asyncpg://liberchat:liberchat@db:5432/liberchat
SYNC_DATABASE_URL=postgresql://liberchat:liberchat@db:5432/liberchat
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string
CONTACT_REF_SALT=change-me-to-a-different-long-random-string

MEDIA_BUCKET=liberchat-media
MEDIA_STORAGE_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=

SAFER_API_KEY=
NCMEC_REPORT_ENDPOINT=

SMS_PROVIDER_API_KEY=

MEDIA_SESSION_TIMEOUT_MINUTES=5
POST_DEFAULT_EXPIRY_HOURS=72
